# Every value here has a working default. Copy to .env only to change one.
#
#   cp .env.example .env
#
# backend/.env is a different file: it holds live Jira credentials for the
# optional live tests, and is gitignored.

# --- Environment --------------------------------------------------------
# production enforces HTTPS and secure cookies, and refuses both the local key
# provider and the mock authentication mode.
APP_ENV=development

# --- Ports --------------------------------------------------------------
WEB_PORT=3000          # the application
API_PORT=8080          # direct API access, for curl
TEMPORAL_UI_PORT=8233  # Temporal's own interface
POSTGRES_PORT=5432
KMS_PORT=4566

# --- Secrets ------------------------------------------------------------
# The scheme selects the provider, through the Go CDK. Locally this is the
# floci emulator speaking the real KMS protocol; in production, drop the
# endpoint override and this same value reaches AWS KMS.
#
# Alternatives: gcpkms://, azurekeyvault://, hashivault://, base64key://
SECRETS_KEEPER_URL=awskms://alias/identityhub

# --- Authentication -----------------------------------------------------
# A person signs in and this application issues a signed access token. The
# organization and account are claims on that token, so a caller cannot name a
# tenancy it was not issued for.
#
# A real deployment federates instead: Auth0, Clerk or Okta authenticates the
# person and issues the token, and this application does what it does either
# way -- read it. That swap replaces one resolver and deletes the sign-in
# endpoint; nothing downstream changes.

# What a token's iss and aud claims are stamped with, and checked against. A
# valid signature on a token minted for a different application is still one
# this application must reject.
TOKEN_ISSUER=https://identityhub.local
TOKEN_AUDIENCE=identityhub

# Signs and verifies every access token, HMAC-SHA256. The value below is
# published in this repository, so configuration refuses it when
# APP_ENV=production: anyone holding it can mint a token for any tenant.
TOKEN_SIGNING_KEY=dev-signing-key-not-for-production

# How long a token lasts. There is no refresh flow -- renewing a credential is
# the identity provider's side of the exchange.
TOKEN_TTL=1h

# --- Blog digest --------------------------------------------------------
# Which project the daily digest files into. An override: leave it empty and the
# digest files into the first project the connected account can reach, so the
# feature works without looking a key up first.
DIGEST_PROJECT_KEY=

# Optional. Without it the digest uses an offline summarizer, so the stack runs
# with no Anthropic account and no network access.
ANTHROPIC_API_KEY=

BLOG_FEED_URL=https://www.oasis.security/blog

# --- Database -----------------------------------------------------------
POSTGRES_PASSWORD=identityhub

# The password given to identityhub_app, the role the API and worker connect
# as. It can read and write rows and nothing else -- no DDL, no ownership.
# This default is published in the repository, so it is refused when
# APP_ENV=production.
APP_DB_PASSWORD=identityhub_app
